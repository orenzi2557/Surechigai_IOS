	<string>同じネットワーク上の開発用サーバーと通信するために使用します</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 開発用: ローカルの HTTP サーバー(http://IP:8000)へ接続するための例外。本番では削除すること。 -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
